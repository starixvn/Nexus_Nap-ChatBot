@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fanex.NCB.Main</title>
    <base href="%PUBLIC_URL%/" />    

    <environment include="Development">
        <link href="https://fonts.googleapis.com/css?family=Roboto:400,500,700" rel="stylesheet">
        <link rel="stylesheet" href="/dev/common/common.chunk.css" asp-append-version="true" />
        <link rel="stylesheet" href="/dev/pages/layout/layout.css" asp-append-version="true" />
        
    </environment>
    <environment exclude="Development">
        <link href="https://fonts.googleapis.com/css?family=Roboto:400,500,700" rel="stylesheet">
        <link rel="stylesheet" href="/pro/common/common.chunk.css" asp-append-version="true" />
        <link rel="stylesheet" href="/pro/pages/layout/layout.css" asp-append-version="true" />
    </environment>
</head>
<body>   
    <div id="layout">test</div>    

    <environment include="Development">
        <script src="/dev/pages/layout/layout.chunk.js" asp-append-version="true"></script>
        <script src="/dev/common/common.chunk.js" asp-append-version="true"></script>          
    </environment>
    <environment exclude="Development">
        <script src="/pro/pages/layout/layout.chunk.js" asp-append-version="true"></script>
        <script src="/pro/common/common.chunk.js" asp-append-version="true"></script>  
    </environment>    
</body>
</html>
