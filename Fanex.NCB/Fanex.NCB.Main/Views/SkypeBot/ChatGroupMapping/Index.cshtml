@{
    ViewData["Title"] = "Chat Group Mapping";
    Layout = "_ContentLayout";
}

<div id="root">test</div>

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="/js/build/dev/pages/chatgroupmapping.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="/js/build/pro/pages/chatgroupmapping.css" asp-append-version="true" />
    </environment>
}

@section Scripts {    
    <environment include="Development">
        <script src="/js/build/dev/pages/chatgroupmapping.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="/js/build/dev/pro/chatgroupmapping.chunk.js" asp-append-version="true"></script>
    </environment>
}
