<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net5.0</TargetFramework>
      <LangVersion>preview</LangVersion>
        <ApplicationIcon />
        <StartupObject />
    </PropertyGroup>
    <PropertyGroup>
        <PublishProtocol>FileSystem</PublishProtocol>
        <Configuration>Release</Configuration>
        <Platform>Any CPU</Platform>
        <TargetFramework>net5.0</TargetFramework>
        <PublishDir>D:\Deploy\ChatBotHangfire</PublishDir>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <_IsPortable>false</_IsPortable>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <CodeAnalysisRuleSet>Fanex.NCB.AutoJobs.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <PropertyGroup>
        <EnableDefaultContentItems>false</EnableDefaultContentItems>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
      <CodeAnalysisRuleSet>..\.sonarlint\napchatbotcsharp.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="Views\**" />
      <EmbeddedResource Remove="Views\**" />
      <None Remove="Views\**" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="appsettings.json" />
        <None Remove="appsettings.LOCAL.json" />
        <None Remove="appsettings.PROD.json" />
        <None Remove="appsettings.UAT.json" />
        <None Remove="App_Data\SpNames.xml" />
        <None Remove="logs\log.txt" />
        <None Remove="nlog.config" />
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="..\.sonarlint\napchatbot\CSharp\SonarLint.xml" Link="SonarLint.xml" />
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="appsettings.LOCAL.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="appsettings.PROD.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="appsettings.UAT.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.LOCAL.xml">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.PROD.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.UAT.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="logs\log.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="nlog.config">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Fanex.Data.MySql" Version="4.2.2" />
        <PackageReference Include="Fanex.Data.SqlServer" Version="4.2.2" />
        <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.0.0" />
        <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
        <PackageReference Include="Fanex.Logging.Sentry" Version="1.0.6" />
        <PackageReference Include="Hangfire.AspNetCore" Version="1.7.22" />
        <PackageReference Include="HangFire.Redis.StackExchange" Version="1.8.4" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="5.0.1" />
        <PackageReference Include="Microsoft.NET.Sdk.Razor" Version="3.1.14" />
        <PackageReference Include="Microsoft.AspNetCore.Hosting.WindowsServices" Version="5.0.5" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="5.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="5.0.0" />
        <PackageReference Include="NLog.Web.AspNetCore" Version="4.12.0" />
        <PackageReference Include="SonarAnalyzer.CSharp" Version="8.1.0.13383">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Fanex.NCB.Services\Fanex.NCB.Services.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Resources\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Program.cs" />
        <Compile Include="Program.cs">
            <SonarQubeExclude>true</SonarQubeExclude>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Resources\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
</Project>