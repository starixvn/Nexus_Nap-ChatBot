{
    "presets": ["@babel/preset-react",["@babel/preset-env",{
      "targets": {
        "chrome": "71",
        "firefox": "64",
		"edge": "40",
        }}]
    ],
   "plugins": ["@babel/plugin-syntax-jsx","@babel/plugin-transform-react-jsx","@babel/plugin-transform-react-display-name","@babel/plugin-transform-react-jsx-source",
    "@babel/plugin-transform-react-jsx-self","@babel/plugin-proposal-class-properties"],
    "env": {
      "test": {
        "presets":  ["@babel/preset-react","@babel/preset-env"],
        "plugins": ["@babel/plugin-syntax-jsx","@babel/plugin-transform-react-jsx","@babel/plugin-transform-react-display-name",
          "@babel/plugin-transform-react-jsx-source","@babel/plugin-transform-react-jsx-self","@babel/plugin-proposal-class-properties"]
      }
    }   
}