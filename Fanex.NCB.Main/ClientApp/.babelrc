{
    "presets": [
        "@babel/preset-react",
        [
            "@babel/preset-env",
            {
                "targets": {
                    "chrome": "71",
                    "firefox": "64",
                    "edge": "40"
                }
            }
        ]
    ],
    "plugins": [ "@babel/proposal-object-rest-spread", "@babel/proposal-class-properties", "@babel/syntax-dynamic-import" ],
    "env": {
        "test": {
            "plugins": [ "dynamic-import-node" ]
        }
    }
}