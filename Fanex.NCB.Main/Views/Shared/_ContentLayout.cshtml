<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <base href="~/" />

    <environment include="Development">
        <link rel="stylesheet" href="~/dev/common/bootstrapvendor.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/pro/common/bootstrapvendor.chunk.css" asp-append-version="true" />
    </environment>
    @RenderSection("Styles", required: false)
</head>

<body>

    @Html.AntiForgeryToken()

    <div id="layout">
        @RenderBody()
    </div>
    <input type="hidden" id="root-url" value="@Url.Content("~/")" />
    <input type="hidden" id="logged-username" value="@User.Identity.Name" />
    <input type="hidden" id="current-controller" value="@ViewContext.RouteData.Values["Controller"].ToString()" />
    <input type="hidden" id="current-action" value="@ViewContext.RouteData.Values["Action"].ToString()" />
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
    <environment include="Development">
        <script src="~/dev/common/reactvendor.chunk.js" asp-append-version="true"></script>
        <script src="~/dev/common/bootstrapvendor.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/pro/common/reactvendor.chunk.js" asp-append-version="true"></script>
        <script src="~/pro/common/bootstrapvendor.chunk.js" asp-append-version="true"></script>
    </environment>
    @RenderSection("Scripts", required: false)
</body>
</html>