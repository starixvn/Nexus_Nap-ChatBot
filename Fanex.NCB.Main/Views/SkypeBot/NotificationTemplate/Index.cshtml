@{
	ViewData["Title"] = "Notification Template";
}

<input class="d-none" type="checkbox" checked="@((bool)ViewBag.HaveHostPermission)" id="have-host-permission"/>

<div id="root"></div>

@section Styles {
	<environment include="Development">
		<link rel="stylesheet" href="~/dev/pages/notificationtemplate/notificationtemplate.chunk.css" asp-append-version="true"/>
	</environment>
	<environment exclude="Development">
		<link rel="stylesheet" href="~/pro/pages/notificationtemplate/notificationtemplate.chunk.css" asp-append-version="true"/>
	</environment>
}

@section Scripts {
	<environment include="Development">
		<script src="~/dev/pages/notificationtemplate/notificationtemplate.chunk.js" asp-append-version="true"></script>
	</environment>
	<environment exclude="Development">
		<script src="~/pro/pages/notificationtemplate/notificationtemplate.chunk.js" asp-append-version="true"></script>
	</environment>
}