@using Newtonsoft.Json

@{
    ViewData["Title"] = "Home Page";
    Layout = null;
    var menus = ViewBag.Menu as List<Fanex.NCB.Core.Models.Menu>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fanex.NCB.Main</title>
    <base href="~/" />

    <environment include="Development">
        <link href="https://fonts.googleapis.com/css?family=Roboto:400,500,700" rel="stylesheet">
        <link rel="stylesheet" href="~/dev/common/bootstrapvendor.chunk.css" asp-append-version="true">
        <link rel="stylesheet" href="~/dev/pages/home/home.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="https://fonts.googleapis.com/css?family=Roboto:400,500,700" rel="stylesheet">
        <link rel="stylesheet" href="~/pro/common/bootstrapvendor.chunk.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/pro/pages/home/home.chunk.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <div id="layout">test</div>

    <script>
        window._AppData = {
            menus: @Html.Raw(JsonConvert.SerializeObject(menus))
        }
        window.rootUrl = '@Url.Content("~/")';
    </script>

    <environment include="Development">
        <script src="~/dev/common/reactvendor.chunk.js" asp-append-version="true"></script>
        <script src="~/dev/common/bootstrapvendor.chunk.js" asp-append-version="true"></script>
        <script src="~/dev/pages/home/home.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/pro/common/reactvendor.chunk.js" asp-append-version="true"></script>
        <script src="~/pro/common/bootstrapvendor.chunk.js" asp-append-version="true"></script>
        <script src="~/pro/pages/home/home.chunk.js" asp-append-version="true"></script>
    </environment>
</body>
</html>